# Large raw source downloads are fetched on demand (or by CI) — see each
# subfolder's README — and are NOT committed. Small provenance/verification
# snapshots (probe.json, *.md) ARE committed so upstream drift shows in diffs.
*.csv
*.tsv
*.zip
*.gz
*.7z
*.geojson
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.xlsx
*.parquet

# VASCAN's Darwin Core Archive — 2.9 MB zipped, ~37 MB unpacked, and refetched
# by `npm run probe:vascan`. Only the probe's summary is committed.
vascan/vascan-dwca.zip
vascan/dwca/

# Plant-SyNZ raw reports, cached by `npm run host-counts:nz`. Only the
# derived counts (host-counts.json) are committed.
plant-synz/cache/
