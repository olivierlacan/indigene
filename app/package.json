{
  "name": "indigene",
  "version": "0.28.0",
  "private": true,
  "description": "Native Indigene \u2014 a mobile-first PWA that recommends locally native plants for the exact spot you're standing in.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prerender": "node scripts/prerender.mjs",
    "publish:cloudflare": "node scripts/publish.mjs cloudflare",
    "publish:gh-pages": "node scripts/publish.mjs gh-pages",
    "routes:check": "node scripts/check-routes.mjs",
    "chunks:check": "node scripts/check-chunks.mjs",
    "release-notes": "node scripts/build-release-notes.mjs",
    "notes:check": "node scripts/check-notes-lightbox.mjs",
    "guide": "node scripts/build-guide.mjs",
    "guide:check": "node scripts/build-guide.mjs --check",
    "coverage": "node scripts/coverage.mjs",
    "swaps:coverage": "node scripts/alternatives-coverage.mjs",
    "conservation": "NODE_USE_ENV_PROXY=1 node scripts/conservation.mjs",
    "wildlife": "NODE_USE_ENV_PROXY=1 node scripts/wildlife-candidates.mjs",
    "candidates": "NODE_USE_ENV_PROXY=1 node scripts/candidates.mjs",
    "host-counts": "node scripts/build-host-counts.mjs",
    "maps:build": "NODE_USE_ENV_PROXY=1 node scripts/build-region-maps.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "region-counts": "NODE_USE_ENV_PROXY=1 node scripts/build-region-counts.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "hero:harvest": "NODE_USE_ENV_PROXY=1 node scripts/harvest-hero-photos.mjs",
    "hero:inat": "NODE_USE_ENV_PROXY=1 node scripts/inat-heroes.mjs",
    "hero:review": "node scripts/build-hero-review.mjs",
    "hero:colors": "NODE_USE_ENV_PROXY=1 node scripts/hero-colors.mjs",
    "reconcile": "NODE_USE_ENV_PROXY=1 node scripts/reconcile.mjs",
    "names:check": "NODE_USE_ENV_PROXY=1 node scripts/check-vernacular.mjs",
    "prose:check": "node scripts/check-prose.mjs",
    "blurbs:check": "node scripts/check-blurbs.mjs",
    "lookalikes:check": "NODE_USE_ENV_PROXY=1 node scripts/check-lookalikes.mjs",
    "inat:check": "NODE_USE_ENV_PROXY=1 node scripts/inat-coverage-check.mjs",
    "probe:globi": "NODE_USE_ENV_PROXY=1 node scripts/probe-globi.mjs",
    "probe:eea": "NODE_USE_ENV_PROXY=1 node scripts/probe-eea.mjs",
    "swipe:check": "node scripts/check-lightbox-swipe.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
